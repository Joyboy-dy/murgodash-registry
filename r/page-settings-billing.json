{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page-settings-billing",
  "type": "registry:page",
  "title": "Page Settings Billing",
  "description": "Generated from playground/app/settings/billing/page.tsx.",
  "files": [
