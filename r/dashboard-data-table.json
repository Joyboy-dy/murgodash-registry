{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-data-table",
  "type": "registry:ui",
  "title": "Dashboard Data Table",
  "description": "Generated from playground/components/dashboard/data-table.tsx.",
  "files": [
    {
      "path": "components/dashboard/data-table.tsx",
      "type": "registry:ui",
      "target": "components/dashboard/data-table.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Alert01Icon,\n  ArrowDown01Icon,\n  ArrowUp01Icon,\n  CheckmarkCircle02Icon,\n  Delete02Icon,\n  Edit02Icon,\n  MoreVerticalIcon,\n  PlusSignIcon,\n  SquareArrowUp01Icon,\n} from \"@hugeicons/core-free-icons\"\nimport { HugeiconsIcon } from \"@hugeicons/react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Dialog,\n  DialogBody,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\"\nimport {\n  ChartContainer,\n  ChartTooltip,\n  ChartTooltipContent,\n  type ChartConfig,\n} from \"@/components/ui/chart\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/components/ui/drawer\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport { Separator } from \"@/components/ui/separator\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from \"@/components/ui/tabs\"\nimport { Area, AreaChart, CartesianGrid, XAxis } from \"recharts\"\n\nimport { useIsMobile } from \"@/hooks/use-mobile\"\n\ninterface DataRow {\n  id: number\n  header: string\n  type: string\n  status: string\n  target: string\n  limit: string\n  reviewer: string\n}\n\ninterface DataTableProps {\n  data: DataRow[]\n}\n\nconst chartData = [\n  { month: \"January\", desktop: 186, mobile: 80 },\n  { month: \"February\", desktop: 305, mobile: 200 },\n  { month: \"March\", desktop: 237, mobile: 120 },\n  { month: \"April\", desktop: 73, mobile: 190 },\n  { month: \"May\", desktop: 209, mobile: 130 },\n  { month: \"June\", desktop: 214, mobile: 140 },\n]\n\nconst chartConfig = {\n  desktop: {\n    label: \"Desktop\",\n    color: \"var(--primary)\",\n  },\n  mobile: {\n    label: \"Mobile\",\n    color: \"var(--primary)\",\n  },\n} satisfies ChartConfig\n\nfunction StatusBadge({ status }: { status: string }) {\n  const isDone = status === \"Done\"\n\n  return (\n    <Badge variant=\"outline\" className=\"gap-1.5 px-1.5 text-muted-foreground\">\n      <HugeiconsIcon\n        icon={isDone ? CheckmarkCircle02Icon : ArrowDown01Icon}\n        size={20}\n        strokeWidth={1.5}\n        className={isDone ? \"text-primary\" : \"\"}\n      />\n      {status}\n    </Badge>\n  )\n}\n\nfunction TableCellViewer({ item }: { item: DataRow }) {\n  const isMobile = useIsMobile()\n\n  return (\n    <Drawer direction={isMobile ? \"bottom\" : \"right\"}>\n      <DrawerTrigger asChild>\n        <Button variant=\"link\" className=\"w-fit px-0 text-left text-foreground\">\n          {item.header}\n        </Button>\n      </DrawerTrigger>\n      <DrawerContent>\n        <DrawerHeader className=\"gap-1\">\n          <DrawerTitle>{item.header}</DrawerTitle>\n          <DrawerDescription>\n            Showing total visitors for the last 6 months\n          </DrawerDescription>\n        </DrawerHeader>\n        <div className=\"flex flex-col gap-4 overflow-y-auto px-4 text-sm\">\n          {!isMobile ? (\n            <>\n              <ChartContainer config={chartConfig}>\n                <AreaChart\n                  accessibilityLayer\n                  data={chartData}\n                  margin={{ left: 0, right: 10 }}\n                >\n                  <CartesianGrid vertical={false} />\n                  <XAxis\n                    dataKey=\"month\"\n                    tickLine={false}\n                    axisLine={false}\n                    tickMargin={8}\n                    tickFormatter={(value) => value.slice(0, 3)}\n                    hide\n                  />\n                  <ChartTooltip\n                    cursor={false}\n                    content={<ChartTooltipContent indicator=\"dot\" />}\n                  />\n                  <Area\n                    dataKey=\"mobile\"\n                    type=\"natural\"\n                    fill=\"var(--color-mobile)\"\n                    fillOpacity={0.6}\n                    stroke=\"var(--color-mobile)\"\n                    stackId=\"a\"\n                  />\n                  <Area\n                    dataKey=\"desktop\"\n                    type=\"natural\"\n                    fill=\"var(--color-desktop)\"\n                    fillOpacity={0.4}\n                    stroke=\"var(--color-desktop)\"\n                    stackId=\"a\"\n                  />\n                </AreaChart>\n              </ChartContainer>\n              <Separator />\n              <div className=\"grid gap-2\">\n                <div className=\"flex gap-2 leading-none font-medium\">\n                  Trending up by 5.2% this month\n                  <HugeiconsIcon icon={ArrowUp01Icon} size={20} strokeWidth={1.5} />\n                </div>\n                <div className=\"text-muted-foreground\">\n                  Showing total visitors for the last 6 months. This is just\n                  some random text to test the layout.\n                </div>\n              </div>\n              <Separator />\n            </>\n          ) : null}\n          <form className=\"flex flex-col gap-4\">\n            <div className=\"flex flex-col gap-3\">\n              <Label htmlFor={`header-${item.id}`}>Header</Label>\n              <Input id={`header-${item.id}`} defaultValue={item.header} />\n            </div>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"flex flex-col gap-3\">\n                <Label htmlFor={`type-${item.id}`}>Type</Label>\n                <Input id={`type-${item.id}`} defaultValue={item.type} />\n              </div>\n              <div className=\"flex flex-col gap-3\">\n                <Label htmlFor={`reviewer-${item.id}`}>Reviewer</Label>\n                <Input id={`reviewer-${item.id}`} defaultValue={item.reviewer} />\n              </div>\n            </div>\n          </form>\n        </div>\n        <DrawerFooter>\n          <Button>Save changes</Button>\n          <DrawerClose asChild>\n            <Button variant=\"outline\">Close</Button>\n          </DrawerClose>\n        </DrawerFooter>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n\nfunction TableRowActions({ item }: { item: DataRow }) {\n  const [showEditDialog, setShowEditDialog] = React.useState(false)\n  const [showDeleteDialog, setShowDeleteDialog] = React.useState(false)\n\n  return (\n    <>\n      <DropdownMenu>\n        <DropdownMenuTrigger asChild>\n          <Button\n            variant=\"ghost\"\n            className=\"flex size-8 text-muted-foreground data-[state=open]:bg-muted\"\n            size=\"icon\"\n          >\n            <HugeiconsIcon\n              icon={MoreVerticalIcon}\n              size={20}\n              strokeWidth={1.5}\n            />\n            <span className=\"sr-only\">Open menu</span>\n          </Button>\n        </DropdownMenuTrigger>\n        <DropdownMenuContent align=\"end\" className=\"w-40\">\n          <DropdownMenuItem onClick={() => setShowEditDialog(true)}>\n            <HugeiconsIcon icon={Edit02Icon} size={16} strokeWidth={1.5} className=\"mr-2\" />\n            Edit\n          </DropdownMenuItem>\n          <DropdownMenuItem onClick={() => {}}>\n            <HugeiconsIcon icon={SquareArrowUp01Icon} size={16} strokeWidth={1.5} className=\"mr-2\" />\n            Duplicate\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem \n            variant=\"destructive\" \n            onClick={() => setShowDeleteDialog(true)}\n          >\n            <HugeiconsIcon icon={Delete02Icon} size={16} strokeWidth={1.5} className=\"mr-2\" />\n            Delete\n          </DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n\n      {/* Edit Dialog */}\n      <Dialog open={showEditDialog} onOpenChange={setShowEditDialog}>\n        <DialogContent className=\"sm:max-w-md\">\n          <DialogHeader>\n            <DialogTitle>Edit Row</DialogTitle>\n            <DialogDescription>\n              Make changes to the data row here.\n            </DialogDescription>\n          </DialogHeader>\n          <DialogBody className=\"space-y-4 py-4\">\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"header\">Header</Label>\n              <Input id=\"header\" defaultValue={item.header} />\n            </div>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"grid gap-2\">\n                <Label htmlFor=\"type\">Type</Label>\n                <Input id=\"type\" defaultValue={item.type} />\n              </div>\n              <div className=\"grid gap-2\">\n                <Label htmlFor=\"reviewer\">Reviewer</Label>\n                <Input id=\"reviewer\" defaultValue={item.reviewer} />\n              </div>\n            </div>\n          </DialogBody>\n          <DialogFooter>\n            <Button variant=\"outline\" onClick={() => setShowEditDialog(false)}>\n              Cancel\n            </Button>\n            <Button onClick={() => setShowEditDialog(false)}>\n              Save Changes\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>\n\n      {/* Delete Dialog */}\n      <Dialog open={showDeleteDialog} onOpenChange={setShowDeleteDialog}>\n        <DialogContent className=\"sm:max-w-[400px]\">\n          <DialogHeader>\n            <DialogTitle className=\"flex items-center gap-2\">\n              <HugeiconsIcon icon={Alert01Icon} size={20} className=\"text-destructive\" strokeWidth={1.5} />\n              Delete Row\n            </DialogTitle>\n            <DialogDescription>\n              Are you sure you want to delete this row? This action cannot be undone.\n            </DialogDescription>\n          </DialogHeader>\n          <DialogBody className=\"py-2\">\n            <div className=\"rounded-lg bg-muted/50 p-3 text-sm italic\">\n              « {item.header} » will be permanently removed.\n            </div>\n          </DialogBody>\n          <DialogFooter>\n            <Button variant=\"outline\" onClick={() => setShowDeleteDialog(false)}>\n              Cancel\n            </Button>\n            <Button variant=\"destructive\" onClick={() => setShowDeleteDialog(false)}>\n              Delete Row\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>\n    </>\n  )\n}\n\nexport function DataTable({ data }: DataTableProps) {\n  const [activeTab, setActiveTab] = React.useState(\"outline\")\n  const [query, setQuery] = React.useState(\"\")\n\n  const filteredData = React.useMemo(() => {\n    const normalizedQuery = query.toLowerCase().trim()\n\n    if (!normalizedQuery) {\n      return data\n    }\n\n    return data.filter((item) => {\n      return (\n        item.header.toLowerCase().includes(normalizedQuery) ||\n        item.type.toLowerCase().includes(normalizedQuery) ||\n        item.reviewer.toLowerCase().includes(normalizedQuery)\n      )\n    })\n  }, [data, query])\n\n  return (\n    <Tabs\n      value={activeTab}\n      onValueChange={setActiveTab}\n      className=\"w-full flex-col justify-start gap-6\"\n    >\n      <div className=\"flex items-center justify-between px-4 lg:px-6\">\n        <TabsList className=\"hidden @4xl/main:flex\">\n          <TabsTrigger value=\"outline\">Outline</TabsTrigger>\n          <TabsTrigger value=\"past-performance\">Past Performance</TabsTrigger>\n          <TabsTrigger value=\"key-personnel\">Key Personnel</TabsTrigger>\n          <TabsTrigger value=\"focus-documents\">Focus Documents</TabsTrigger>\n        </TabsList>\n        <div className=\"flex items-center gap-2\">\n          <Button variant=\"outline\" size=\"sm\">\n            <HugeiconsIcon\n              icon={SquareArrowUp01Icon}\n              size={20}\n              strokeWidth={1.5}\n            />\n            <span className=\"hidden lg:inline\">Customize Columns</span>\n            <span className=\"lg:hidden\">Columns</span>\n          </Button>\n          <Button variant=\"outline\" size=\"sm\">\n            <HugeiconsIcon icon={PlusSignIcon} size={20} strokeWidth={1.5} />\n            <span className=\"hidden lg:inline\">Add Section</span>\n          </Button>\n        </div>\n      </div>\n      <TabsContent\n        value=\"outline\"\n        className=\"relative flex flex-col gap-4 overflow-auto px-4 lg:px-6\"\n      >\n        <div className=\"flex items-center gap-3\">\n          <div className=\"relative flex items-center\">\n            <Input\n              value={query}\n              onChange={(event) => setQuery(event.target.value)}\n              placeholder=\"Filter sections\"\n              className=\"max-w-sm pr-10\"\n            />\n            <span className=\"pointer-events-none absolute right-2.5 flex size-5 items-center justify-center rounded-full bg-primary text-[10px] font-semibold text-primary-foreground\">\n              {filteredData.length}\n            </span>\n          </div>\n        </div>\n        <div className=\"overflow-hidden rounded-lg border\">\n          <Table>\n            <TableHeader className=\"sticky top-0 z-10 bg-muted\">\n              <TableRow>\n                <TableHead>Header</TableHead>\n                <TableHead>Type</TableHead>\n                <TableHead>Status</TableHead>\n                <TableHead className=\"text-right\">Target</TableHead>\n                <TableHead className=\"text-right\">Limit</TableHead>\n                <TableHead>Reviewer</TableHead>\n                <TableHead className=\"w-12\" />\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              {filteredData.map((item) => (\n                <TableRow key={item.id}>\n                  <TableCell>\n                    <TableCellViewer item={item} />\n                  </TableCell>\n                  <TableCell>{item.type}</TableCell>\n                  <TableCell>\n                    <StatusBadge status={item.status} />\n                  </TableCell>\n                  <TableCell className=\"text-right\">{item.target}</TableCell>\n                  <TableCell className=\"text-right\">{item.limit}</TableCell>\n                  <TableCell>{item.reviewer}</TableCell>\n                  <TableCell>\n                    <TableRowActions item={item} />\n                  </TableCell>\n                </TableRow>\n              ))}\n            </TableBody>\n          </Table>\n        </div>\n      </TabsContent>\n      <TabsContent\n        value=\"past-performance\"\n        className=\"flex flex-col px-4 lg:px-6\"\n      >\n        <div className=\"aspect-video w-full flex-1 rounded-lg border border-dashed\" />\n      </TabsContent>\n      <TabsContent value=\"key-personnel\" className=\"flex flex-col px-4 lg:px-6\">\n        <div className=\"aspect-video w-full flex-1 rounded-lg border border-dashed\" />\n      </TabsContent>\n      <TabsContent\n        value=\"focus-documents\"\n        className=\"flex flex-col px-4 lg:px-6\"\n      >\n        <div className=\"aspect-video w-full flex-1 rounded-lg border border-dashed\" />\n      </TabsContent>\n    </Tabs>\n  )\n}\n"
    }
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/badge.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/button.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/chart.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/dialog.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/drawer.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/dropdown-menu.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/hook-use-mobile.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/input.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/label.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/separator.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/table.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/tabs.json"
  ]
}
