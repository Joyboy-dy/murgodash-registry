{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page-settings-account",
  "type": "registry:page",
  "title": "Page Settings Account",
  "description": "Generated from playground/app/settings/account/page.tsx.",
  "files": [
    {
      "path": "app/settings/account/page.tsx",
      "type": "registry:page",
      "target": "app/settings/account/page.tsx",
      "content": "\"use client\";\n\nimport * as React from \"react\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  Alert01Icon,\n  Tick02Icon,\n  UserRemoveIcon,\n  Configuration01Icon,\n  Download01Icon,\n  Calendar02Icon,\n  RocketIcon,\n  GlobeIcon,\n  TranslateIcon,\n  Clock01Icon,\n  Settings01Icon,\n  GlobalIcon,\n  Search01Icon,\n  Notification01Icon,\n} from \"@hugeicons/core-free-icons\";\n\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Switch } from \"@/components/ui/switch\";\n\nexport default function AccountPage() {\n  const [isSaving, setIsSaving] = React.useState(false);\n\n  const handleSave = () => {\n    setIsSaving(true);\n    setTimeout(() => setIsSaving(false), 2000);\n  };\n\n  return (\n    <div className=\"flex flex-col gap-8 p-4 md:p-8 max-w-4xl mx-auto w-full pb-24\">\n      <div>\n        <h1 className=\"text-3xl font-bold tracking-tight text-foreground\">\n          Account Settings\n        </h1>\n        <p className=\"text-muted-foreground mt-1 text-sm md:text-base\">\n          Manage your account preferences, application-wide configurations, and\n          data status.\n        </p>\n      </div>\n\n      <div className=\"grid gap-8\">\n        {/* Account Essentials Section */}\n        <div className=\"grid gap-6\">\n          <div className=\"flex items-center justify-between gap-4 flex-wrap\">\n            <div>\n              <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n                <HugeiconsIcon\n                  icon={Configuration01Icon}\n                  size={20}\n                  strokeWidth={1.5}\n                />\n                Account Essentials\n              </h2>\n              <p className=\"text-sm text-muted-foreground mt-1\">\n                Core identity and administrative information.\n              </p>\n            </div>\n            <div className=\"flex items-center gap-2 p-2 px-3 bg-muted/50 rounded-lg border border-border/50\">\n              <HugeiconsIcon\n                icon={Calendar02Icon}\n                size={16}\n                strokeWidth={1.5}\n                className=\"text-muted-foreground\"\n              />\n              <span className=\"text-xs font-medium\">Joined June 2024</span>\n            </div>\n          </div>\n\n          <Card className=\"border border-border/50 bg-muted/20\">\n            <CardContent className=\"pt-6 grid gap-4\">\n              <div className=\"flex items-center justify-between p-4 border border-border/50 rounded-xl bg-card transition-all hover:border-primary/20\">\n                <div className=\"grid gap-0.5\">\n                  <span className=\"text-sm font-medium\">Account ID</span>\n                  <span className=\"text-xs text-muted-foreground font-mono\">\n                    USR_8274_9102\n                  </span>\n                </div>\n                <Badge\n                  variant=\"outline\"\n                  className=\"bg-primary/5 text-primary border-primary/20\"\n                >\n                  Verified\n                </Badge>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <Separator className=\"bg-border/50\" />\n\n        {/* App Information Section (From Global) */}\n        <div className=\"grid gap-6\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon icon={RocketIcon} size={20} strokeWidth={1.5} />\n              Application Info\n            </h2>\n            <Separator className=\"flex-1 bg-border/50\" />\n          </div>\n\n          <Card className=\"border border-border/50 bg-muted/20\">\n            <CardContent className=\"pt-6 grid gap-6\">\n              <div className=\"grid sm:grid-cols-2 gap-4\">\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"app-name\">Application Name</Label>\n                  <Input\n                    id=\"app-name\"\n                    defaultValue=\"Murgo Dash\"\n                    placeholder=\"e.g. My Dashboard\"\n                    className=\"bg-card\"\n                  />\n                </div>\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"app-url\">Site URL</Label>\n                  <Input\n                    id=\"app-url\"\n                    defaultValue=\"https://murgodash.dev\"\n                    placeholder=\"e.g. https://example.com\"\n                    className=\"bg-card\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid gap-2\">\n                <Label htmlFor=\"seo-description\">SEO Description</Label>\n                <Input\n                  id=\"seo-description\"\n                  defaultValue=\"The ultimate dashboard for modern businesses.\"\n                  placeholder=\"Describe your site for search engines\"\n                  className=\"bg-card\"\n                />\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        {/* Localization & Region (From Global) */}\n        <div className=\"grid gap-6\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon icon={GlobeIcon} size={20} strokeWidth={1.5} />\n              Localization & Region\n            </h2>\n            <Separator className=\"flex-1 bg-border/50\" />\n          </div>\n\n          <div className=\"grid sm:grid-cols-2 gap-4\">\n            <div className=\"grid gap-2\">\n              <Label\n                htmlFor=\"default-lang\"\n                className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground\"\n              >\n                <HugeiconsIcon icon={TranslateIcon} size={14} />\n                Preferred Language\n              </Label>\n              <Select defaultValue=\"en\">\n                <SelectTrigger id=\"default-lang\" className=\"bg-card\">\n                  <SelectValue placeholder=\"Select Language\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"en\">English (US)</SelectItem>\n                  <SelectItem value=\"fr\">French (France)</SelectItem>\n                  <SelectItem value=\"es\">Spanish</SelectItem>\n                  <SelectItem value=\"de\">German</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n            <div className=\"grid gap-2\">\n              <Label\n                htmlFor=\"timezone\"\n                className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground\"\n              >\n                <HugeiconsIcon icon={Clock01Icon} size={14} />\n                Default Timezone\n              </Label>\n              <Select defaultValue=\"utc\">\n                <SelectTrigger id=\"timezone\" className=\"bg-card\">\n                  <SelectValue placeholder=\"Select Timezone\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"utc\">UTC (Universal Time)</SelectItem>\n                  <SelectItem value=\"utc+1\">GMT +1 (Porto-Novo)</SelectItem>\n                  <SelectItem value=\"est\">EST (Eastern Time)</SelectItem>\n                  <SelectItem value=\"pst\">PST (Pacific Time)</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n          </div>\n        </div>\n\n        {/* System Behavior (From Global) */}\n        <div className=\"grid gap-6\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon\n                icon={Settings01Icon}\n                size={20}\n                strokeWidth={1.5}\n              />\n              System Behavior\n            </h2>\n            <Separator className=\"flex-1 bg-border/50\" />\n          </div>\n\n          <div className=\"grid gap-4\">\n            <div className=\"flex items-center justify-between p-4 border border-border/50 rounded-xl bg-card transition-all hover:bg-muted/30\">\n              <div className=\"flex items-start gap-4\">\n                <div className=\"p-2 rounded-lg bg-orange-500/10 text-orange-500 shrink-0\">\n                  <HugeiconsIcon\n                    icon={GlobalIcon}\n                    size={20}\n                    strokeWidth={1.5}\n                  />\n                </div>\n                <div className=\"grid gap-1\">\n                  <p className=\"text-sm font-medium leading-none\">\n                    Maintenance Mode\n                  </p>\n                  <p className=\"text-xs text-muted-foreground whitespace-pre-wrap\">\n                    Disable public access to the dashboard during updates.\n                  </p>\n                </div>\n              </div>\n              <Switch />\n            </div>\n\n            <div className=\"flex items-center justify-between p-4 border border-border/50 rounded-xl bg-card transition-all hover:bg-muted/30\">\n              <div className=\"flex items-start gap-4\">\n                <div className=\"p-2 rounded-lg bg-blue-500/10 text-blue-500 shrink-0\">\n                  <HugeiconsIcon\n                    icon={Search01Icon}\n                    size={20}\n                    strokeWidth={1.5}\n                  />\n                </div>\n                <div className=\"grid gap-1\">\n                  <p className=\"text-sm font-medium leading-none\">\n                    Search Indexing\n                  </p>\n                  <p className=\"text-xs text-muted-foreground whitespace-pre-wrap\">\n                    Allow search engines to crawl and index your site content.\n                  </p>\n                </div>\n              </div>\n              <Switch defaultChecked />\n            </div>\n          </div>\n        </div>\n\n        {/* Notification Settings (From Global) */}\n        <div className=\"grid gap-6\">\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon\n                icon={Notification01Icon}\n                size={20}\n                strokeWidth={1.5}\n              />\n              Notification Settings\n            </h2>\n            <Separator className=\"flex-1 bg-border/50\" />\n          </div>\n\n          <div className=\"grid gap-4\">\n            <Card className=\"border border-border/50 bg-muted/20\">\n              <CardContent className=\"pt-6 grid gap-4\">\n                <p className=\"text-[10px] font-bold tracking-widest text-muted-foreground uppercase opacity-70\">\n                  Delivery Channels\n                </p>\n                <div className=\"flex items-center justify-between p-3 rounded-lg border border-border/50 bg-card\">\n                  <div className=\"grid gap-1\">\n                    <p className=\"text-sm font-medium leading-none\">\n                      Email Notifications\n                    </p>\n                    <p className=\"text-xs text-muted-foreground\">\n                      Receive critical alerts via email.\n                    </p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <div className=\"flex items-center justify-between p-3 rounded-lg border border-border/50 bg-card\">\n                  <div className=\"grid gap-1\">\n                    <p className=\"text-sm font-medium leading-none\">\n                      Browser Push\n                    </p>\n                    <p className=\"text-xs text-muted-foreground\">\n                      Receive real-time dashboard notifications.\n                    </p>\n                  </div>\n                  <Switch />\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card className=\"border border-border/50 bg-muted/20\">\n              <CardContent className=\"pt-6 grid gap-4\">\n                <p className=\"text-[10px] font-bold tracking-widest text-muted-foreground uppercase opacity-70\">\n                  Subscription Topics\n                </p>\n                <div className=\"flex items-center justify-between p-2\">\n                  <div className=\"grid gap-1\">\n                    <span className=\"text-sm font-medium\">\n                      Billing & Invoices\n                    </span>\n                    <span className=\"text-xs text-muted-foreground\">\n                      Get notified about receipts and payment failures.\n                    </span>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <Separator className=\"bg-border/50\" />\n                <div className=\"flex items-center justify-between p-2\">\n                  <div className=\"grid gap-1\">\n                    <span className=\"text-sm font-medium\">Security Alerts</span>\n                    <span className=\"text-xs text-muted-foreground\">\n                      Get notified about new logins and password changes.\n                    </span>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <Separator className=\"bg-border/50\" />\n                <div className=\"flex items-center justify-between p-2\">\n                  <div className=\"grid gap-1\">\n                    <span className=\"text-sm font-medium\">\n                      Marketing & News\n                    </span>\n                    <span className=\"text-xs text-muted-foreground\">\n                      Stay updated on new features and product tips.\n                    </span>\n                  </div>\n                  <Switch />\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n\n        <Separator className=\"bg-border/50\" />\n\n        {/* Data Management Section */}\n        <div className=\"grid gap-6\">\n          <div>\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon\n                icon={Download01Icon}\n                size={20}\n                strokeWidth={1.5}\n              />\n              Data Management\n            </h2>\n            <p className=\"text-sm text-muted-foreground mt-1\">\n              Download your account information or archive your history.\n            </p>\n          </div>\n\n          <Card className=\"border border-border/50 bg-muted/20 transition-all hover:bg-muted/30\">\n            <CardContent className=\"pt-6 flex flex-wrap items-center justify-between gap-4\">\n              <div className=\"grid gap-1\">\n                <span className=\"text-sm font-medium\">\n                  Export Personal Data\n                </span>\n                <span className=\"text-xs text-muted-foreground\">\n                  Download a complete copy of your personal data in JSON format\n                  for your records.\n                </span>\n              </div>\n              <Button variant=\"outline\" size=\"sm\" className=\"gap-2 shrink-0\">\n                <HugeiconsIcon\n                  icon={Download01Icon}\n                  size={16}\n                  strokeWidth={1.5}\n                />\n                Export Profile\n              </Button>\n            </CardContent>\n          </Card>\n        </div>\n\n        <Separator className=\"bg-border/50\" />\n\n        {/* Danger Zone */}\n        <div className=\"grid gap-6\">\n          <div>\n            <h2 className=\"text-lg font-semibold flex items-center gap-2 text-destructive\">\n              <HugeiconsIcon icon={Alert01Icon} size={20} strokeWidth={1.5} />\n              Danger Zone\n            </h2>\n            <p className=\"text-sm text-muted-foreground mt-1\">\n              Irreversible actions related to your account.\n            </p>\n          </div>\n\n          <Card className=\"border border-destructive/20 bg-destructive/5\">\n            <CardHeader>\n              <CardTitle className=\"text-base font-medium text-destructive\">\n                Delete Account\n              </CardTitle>\n              <CardDescription className=\"text-destructive/80 text-xs md:text-sm\">\n                Once you delete your account, there is no going back. Please be\n                certain.\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <Button\n                variant=\"destructive\"\n                className=\"gap-2 shadow-sm border border-destructive/20\"\n              >\n                <HugeiconsIcon\n                  icon={UserRemoveIcon}\n                  size={18}\n                  strokeWidth={1.5}\n                />\n                Delete my account\n              </Button>\n            </CardContent>\n          </Card>\n        </div>\n\n        <div className=\"flex items-center justify-end gap-3 mt-4\">\n          <Button variant=\"outline\">Discard Changes</Button>\n          <Button\n            className=\"min-w-32 gap-2 shadow-lg shadow-primary/10\"\n            onClick={handleSave}\n            disabled={isSaving}\n          >\n            {isSaving ? (\n              <>Saving...</>\n            ) : (\n              <>\n                <HugeiconsIcon icon={Tick02Icon} size={18} strokeWidth={2} />\n                Save All Changes\n              </>\n            )}\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/badge.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/button.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/card.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/input.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/label.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/select.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/separator.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/switch.json"
  ]
}
