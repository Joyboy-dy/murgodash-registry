      "target": "app/settings/security/page.tsx",
      "content": "\"use client\";\n\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  LockKeyIcon,\n  Shield01Icon,\n  SmartPhone01Icon,\n  Logout01Icon,\n  ComputerIcon,\n} from \"@hugeicons/core-free-icons\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { PasswordInput } from \"@/components/ui/password-input\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Badge } from \"@/components/ui/badge\";\n\nexport default function SecurityPage() {\n  return (\n    <div className=\"flex flex-col gap-8 p-4 md:p-8 max-w-4xl mx-auto w-full pb-24\">\n      <div>\n        <h1 className=\"text-3xl font-bold tracking-tight text-foreground\">\n          Security & Privacy\n        </h1>\n        <p className=\"text-muted-foreground mt-1 text-sm md:text-base\">\n          Manage your credentials, two-factor authentication, and monitor your\n          active sessions.\n        </p>\n      </div>\n\n      <div className=\"grid gap-8\">\n        {/* Password Section */}\n        <div className=\"grid gap-6\">\n          <div>\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon icon={LockKeyIcon} size={20} strokeWidth={1.5} />\n              Password\n            </h2>\n            <p className=\"text-sm text-muted-foreground mt-1\">\n              Ensure your account is using a strong password. It is recommended\n              to change it every 6 months.\n            </p>\n          </div>\n\n          <Card className=\"border border-border/50 bg-muted/20\">\n            <CardHeader>\n              <CardTitle className=\"text-base font-medium\">\n                Update Password\n              </CardTitle>\n              <CardDescription>\n                Enter your current password and choose a new one.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"grid gap-4\">\n              <div className=\"grid gap-2\">\n                <Label htmlFor=\"current-password\">Current Password</Label>\n                <PasswordInput id=\"current-password\" placeholder=\"••••••••\" />\n              </div>\n              <div className=\"grid sm:grid-cols-2 gap-4\">\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"new-password\">New Password</Label>\n                  <PasswordInput id=\"new-password\" placeholder=\"••••••••\" />\n                </div>\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"confirm-password\">Confirm Password</Label>\n                  <PasswordInput id=\"confirm-password\" placeholder=\"••••••••\" />\n                </div>\n              </div>\n              <div className=\"flex justify-start\">\n                <Button variant=\"outline\" size=\"sm\">\n                  Update Password\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <Separator className=\"bg-border/50\" />\n\n        {/* 2FA Section */}\n        <div className=\"grid gap-6\">\n          <div>\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon icon={Shield01Icon} size={20} strokeWidth={1.5} />\n              Two-Factor Authentication\n            </h2>\n            <p className=\"text-sm text-muted-foreground mt-1\">\n              Add an extra layer of security to your account by requiring more\n              than just a password to log in.\n            </p>\n          </div>\n\n          <Card className=\"border border-border/50 bg-muted/20\">\n            <CardContent className=\"pt-6\">\n              <div className=\"flex items-center justify-between gap-4\">\n                <div className=\"flex items-start gap-4\">\n                  <div className=\"p-2 rounded-lg bg-primary/10 text-primary shrink-0\">\n                    <HugeiconsIcon\n                      icon={Shield01Icon}\n                      size={20}\n                      strokeWidth={1.5}\n                    />\n                  </div>\n                  <div className=\"grid gap-1\">\n                    <p className=\"text-sm font-medium leading-none\">\n                      Enable 2FA via Authenticator App\n                    </p>\n                    <p className=\"text-xs text-muted-foreground\">\n                      Use apps like Google Authenticator or 1Password to\n                      generate codes.\n                    </p>\n                  </div>\n                </div>\n                <Switch />\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <Separator className=\"bg-border/50\" />\n\n        {/* Sessions Section */}\n        <div className=\"grid gap-6\">\n          <div>\n            <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n              <HugeiconsIcon\n                icon={SmartPhone01Icon}\n                size={20}\n                strokeWidth={1.5}\n              />\n              Active Sessions\n            </h2>\n            <p className=\"text-sm text-muted-foreground mt-1\">\n              This is a list of devices that have logged into your account.\n              Revoke any sessions that you do not recognize.\n            </p>\n          </div>\n\n          <div className=\"grid gap-3\">\n            {[\n              {\n                device: \"MacBook Pro\",\n                browser: \"Chrome\",\n                location: \"Cotonou, Benin\",\n                current: true,\n                icon: ComputerIcon,\n              },\n              {\n                device: \"iPhone 15 Pro\",\n                browser: \"Safari\",\n                location: \"Cotonou, Benin\",\n                current: false,\n                icon: SmartPhone01Icon,\n              },\n            ].map((session, index) => (\n              <div\n                key={index}\n                className=\"flex items-center justify-between p-4 border border-border/50 rounded-xl bg-card transition-all hover:border-primary/20\"\n              >\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"p-2.5 rounded-xl bg-muted text-muted-foreground\">\n                    <HugeiconsIcon\n                      icon={session.icon}\n                      size={20}\n                      strokeWidth={1.5}\n                    />\n                  </div>\n                  <div className=\"grid gap-0.5\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-sm font-medium\">\n                        {session.device} • {session.browser}\n                      </span>\n                      {session.current && (\n                        <Badge\n                          variant=\"outline\"\n                          className=\"text-[10px] h-4 py-0 bg-primary/5 text-primary border-primary/20\"\n                        >\n                          Current\n                        </Badge>\n                      )}\n                    </div>\n                    <span className=\"text-xs text-muted-foreground\">\n                      {session.location}\n                    </span>\n                  </div>\n                </div>\n                {!session.current && (\n                  <Button\n                    variant=\"ghost\"\n                    size=\"icon\"\n                    className=\"text-muted-foreground hover:text-destructive hover:bg-destructive/10\"\n                  >\n                    <HugeiconsIcon\n                      icon={Logout01Icon}\n                      size={18}\n                      strokeWidth={1.5}\n                    />\n                  </Button>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/badge.json",
