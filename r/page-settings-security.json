    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/card.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/label.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/password-input.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/separator.json",
    "https://raw.githubusercontent.com/Joyboy-dy/murgodash-registry/main/r/switch.json"
  ]
